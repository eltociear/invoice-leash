{
  "mcpServers": {
    "invoice-leash": {
      "command": "node",
      "args": [
        "mcp/server.mjs"
      ],
      "env": {
        "LEASH_READONLY": "1",
        "LEASH_DEPLOYMENT": "runs/live/desk.json",
        "LEASH_INBOX2": "inbox/inbox-v4-MCP.json"
      }
    },
    "qorechain": {
      "command": "node",
      "args": [
        "node_modules/@qorechain/mcp/dist/bin.js",
        "--network",
        "testnet"
      ]
    }
  }
}
